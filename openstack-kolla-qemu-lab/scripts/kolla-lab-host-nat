#!/bin/bash
# Dedicated lab only. Review addresses/interfaces before installation.
set -euo pipefail

# Kolla/OVS must create br-ex first. systemd retries if it is absent.
ip link show dev br-ex >/dev/null
ip link set dev br-ex up
ip address replace 10.0.0.91/24 dev br-ex
sysctl -w net.ipv4.ip_forward=1

ensure_rule() {
    local table="$1" chain="$2"
    shift 2
    iptables -w -t "$table" -C "$chain" "$@" 2>/dev/null ||
        iptables -w -t "$table" -I "$chain" 1 "$@"
}

ensure_rule filter FORWARD \
    -i br-ex -o enp3s0 -s 10.0.0.20/32 \
    -m conntrack --ctstate NEW,ESTABLISHED,RELATED -j ACCEPT

ensure_rule filter FORWARD \
    -i enp3s0 -o br-ex -d 10.0.0.20/32 \
    -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

ensure_rule nat POSTROUTING \
    -s 10.0.0.20/32 -o enp3s0 -j MASQUERADE
